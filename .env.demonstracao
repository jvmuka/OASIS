# ==================================================
# OASIS - Configuracao de DEMONSTRACAO (uso exclusivamente local)
# ==================================================
# ATENCAO: estes valores sao publicos e servem apenas para executar o
# sistema em uma maquina local com Docker. NAO os utilize em producao.
#
# O pacote de entrega traz uma copia deste arquivo com o nome .env.
# Se o .env for apagado, os scripts iniciar.bat / iniciar.sh o recriam
# a partir deste arquivo.

# --- Banco de Dados ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=OasisDemo2026
# Mesma senha em formato URL-encoded (sem caracteres especiais, fica igual)
POSTGRES_PASSWORD_ENCODED=OasisDemo2026

# --- Backend ---
# Chave de assinatura dos tokens JWT (64 caracteres hexadecimais)
JWT_SECRET=b53e0db30c4e8ac8518eebd83ad1cf7c9cccdf48b0034a8dc5b38fb4edec3a2f

# Senha de demonstracao aceita para todos os usuarios da carga inicial
DEV_SENHA=Teste@2026

# Origem permitida pelo CORS (frontend servido pelo Nginx)
CORS_ORIGIN=http://localhost:5173
