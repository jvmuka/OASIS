@startuml 06_seq_uc07
!include cabecalho.iuml
actor "Porteiro" as P
boundary "TelaEncomendasPortaria" as T
control "ControleCadastros" as CC
control "ControlePortaria" as C
control "ControleSincronizacao" as S
database "Banco de Dados" as BD
actor "Morador" as M

P -> T : abre a tela de encomendas
T -> CC : listarPessoas()
CC -> BD : consultar pessoas e unidades
BD --> CC : pessoas e unidades
CC --> T : lista de pessoas
P -> T : filtra o destinatário (nome, CPF, bloco ou apto)
alt destinatário encontrado
  P -> T : informa descrição e tamanho
  T -> C : registrarEncomenda(pessoa, descrição, tamanho)
  C -> BD : INSERT INTO encomenda (AGUARDANDO_RETIRADA)
  note right of BD
    RN11: gera AVISO individual e
    AVISO_PERFIL para o destinatário,
    exibido nas encomendas e no
    mural do morador (UC05)
  end note
  BD --> C : encomenda registrada
  C ->> S : emitirEvento(ENCOMENDAS, CRIADO)
  S -->> M : atualização em tempo real na tela do morador
  C --> T : confirmação
  T --> P : exibe o registro
else destinatário não encontrado
  T --> P : nenhum resultado; permite nova busca
end
== Retirada (UC08) ==
M -> P : apresenta-se para retirar
P -> T : informa quem retirou
T -> C : registrarRetirada(encomenda, retiradoPor, nome)
C -> BD : UPDATE encomenda
note right of BD
  RN12: exige quem retirou, o funcionário
  e, se terceiro, o nome do retirante;
  status passa a RETIRADA.
end note
alt dados completos e encomenda aguardando retirada
  BD --> C : retirada registrada
  C ->> S : emitirEvento(ENCOMENDAS, ATUALIZADO)
  C --> T : confirmação
  T --> P : exibe a retirada
else dado obrigatório ausente
  BD --> C : RAISE EXCEPTION 'RN12: ...'
  C --> T : mensagem da regra
  T --> P : solicita o dado ausente
else encomenda inexistente ou já retirada
  C --> T : retirada recusada
  T --> P : exibe o motivo
end
@enduml
