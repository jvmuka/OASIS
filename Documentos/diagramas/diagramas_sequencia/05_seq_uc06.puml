@startuml 05_seq_uc06
!include cabecalho.iuml
actor "Solicitante" as M
actor "Porteiro ou\nSíndico" as P
boundary "TelaChaves" as T
control "ControlePortaria" as C
control "ControleSincronizacao" as S
database "Banco de Dados" as BD

M -> P : solicita a chave da área
P -> T : localiza a chave e a pessoa
T -> C : emprestarChave(chave, solicitante, reserva)
C -> C : completar perfil ou pessoa do solicitante
alt solicitante não informado
  C --> T : informe o solicitante
  T --> P : solicita o dado ausente
else solicitante identificado
  C -> BD : INSERT INTO entrega_chave
  note right of BD
    RN09: só empresta chave DISPONIVEL
    e altera o status para EMPRESTADA.
    Solicitante: perfil do morador ou,
    para visitante e prestador, a pessoa.
  end note
  alt chave disponível
    BD --> C : empréstimo registrado
    C ->> S : emitirEvento(CHAVES, ATUALIZADO)
    C --> T : confirmação
    T --> P : exibe a retirada registrada
  else chave já emprestada ou extraviada
    BD --> C : RAISE EXCEPTION 'RN09: ...'
    C --> T : chave indisponível
    T --> P : exibe a situação atual da chave
  end
end
== Devolução ==
M -> P : devolve a chave
P -> T : registra a devolução
T -> C : devolverChave(empréstimo)
C -> BD : UPDATE entrega_chave (data e funcionário)
note right of BD
  RN10: devolução posterior à retirada,
  funcionário obrigatório; a chave
  volta a DISPONIVEL.
end note
alt empréstimo em aberto
  BD --> C : devolução registrada
  C ->> S : emitirEvento(CHAVES, ATUALIZADO)
  C --> T : confirmação
  T --> P : chave disponível novamente
else empréstimo inexistente ou já devolvido
  C --> T : devolução recusada
  T --> P : exibe o motivo
end
@enduml
