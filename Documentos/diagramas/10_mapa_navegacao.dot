nota [shape=note, label="O menu lateral fica visível em todas as telas internas e mostra as\lseções do perfil da pessoa; cada tela só aparece se o módulo indicado\lestiver contratado pelo condomínio. O seletor do menu troca o condomínio\lativo, e o superadministrador acessa todas as telas. Setas tracejadas:\lsaída do sistema e tela embutida em outra.\l", fontsize=7.0, width=3.346, height=0.748, fixedsize=true, pos="127.6,415.3!"];
