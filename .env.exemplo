# ==================================================
# OASIS - Variaveis de Ambiente (Docker Compose)
# ==================================================
# Copie este arquivo para .env e preencha os valores.
# NUNCA commite o .env no Git (ja esta no .gitignore).

# --- Banco de Dados ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=SuaSenhaSeguraAqui
# URL-encoded da senha do banco (substitua caracteres especiais: @ = %40, # = %23 etc.)
POSTGRES_PASSWORD_ENCODED=SuaSenhaSeguraAqui

# --- Backend ---
# Chave secreta para assinatura de tokens JWT (minimo 32 caracteres).
# Gere com: openssl rand -hex 32
JWT_SECRET=

# Senha de desenvolvimento para login sem primeiro acesso (deixar vazio em producao)
DEV_SENHA=Teste@2026

# Origens permitidas pelo CORS (separar por virgula se houver mais de uma)
CORS_ORIGIN=http://localhost:5173

# --- Frontend ---
# Modo demonstracao/desenvolvimento (exibe botoes de acesso rapido e codigos de teste no login).
# Para producao, defina como false para manter a tela limpa e segura.
VITE_MODO_DEMO=true
