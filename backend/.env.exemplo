# Copie este arquivo para .env e ajuste os valores.
# Conexao com o PostgreSQL (ajuste usuario, senha e porta da SUA instalacao)
DATABASE_URL=postgres://postgres:SUA_SENHA@localhost:5432/oasis

# Porta em que a API vai rodar
PORT=3000

# Chave usada para assinar os tokens de sessao (troque em producao)
JWT_SECRET=oasis-dev-troque-esta-chave

# MODO DE AUTENTICACAO DO INCREMENTO 1:
# senha unica de desenvolvimento aceita para todos os usuarios da carga inicial.
# Quando a integracao real com o Firebase entrar (incremento 2), esta variavel sai.
DEV_SENHA=Teste@2026
